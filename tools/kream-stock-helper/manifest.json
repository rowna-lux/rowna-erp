{
  "manifest_version": 3,
  "name": "로우나재고 크림 도우미",
  "version": "1.0.0",
  "description": "로우나 ERP '로우나재고 크림' 전용. 보유 재고의 크림 시세(빠른배송·일반배송 판매입찰, 체결, 95점 목록)를 읽기만 해요. 다른 도우미와 통로·대기줄·작업 탭이 모두 따로예요.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://kream.co.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rowna-lux.github.io/rowna-erp/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}