{
  "manifest_version": 3,
  "name": "로우나 리셀 도우미",
  "version": "1.0.0",
  "description": "로우나 ERP 크림 리셀 소싱(국내몰) 전용. 기존 '로우나 도우미'와 통로·대기줄·작업 탭이 모두 따로라 서로 건드리지 않아요.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://www.musinsa.com/*", "https://musinsa.com/*", "https://kream.co.kr/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://rowna-lux.github.io/rowna-erp/*"], "js": ["bridge.js"], "run_at": "document_start" }]
}
